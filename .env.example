# Copy to .env and edit:  cp .env.example .env
# Pick ONE of the LLM setups below.

# --- A) An Ollama-style server you already run (e.g. on a VPN / another machine) ------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
# LLM_GENERATE_PATH=/api/generate

# --- B) Bundled Ollama via `docker compose --profile ollama up` ------------------------------
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434
# LLM_MODEL=qwen2.5:7b-instruct          # pulled automatically on first start

# --- C) Any OpenAI-compatible API (OpenAI, vLLM, LM Studio, llama.cpp, Groq, Together, ...) --
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com      # vLLM: http://host:8000 · LM Studio: http://localhost:1234
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_GENERATE_PATH=/v1/chat/completions

# Running the app in Docker and the LLM on this same machine? Use host.docker.internal
# instead of localhost, e.g. LLM_BASE_URL=http://host.docker.internal:11434

# --- Optional -------------------------------------------------------------------------------
LLM_TIMEOUT=600
# LLM_TEMPERATURE=0.1
# LLM_CONCURRENCY=4                      # parallel LLM requests per run
# LLM_MAX_TOKENS=4096                    # raise if replies get cut off
# RDF_BASE_IRI=urn:kgstudio:             # base for IRIs in graph.jsonld, e.g. https://example.org/kg/
# EMBED_MODEL=BAAI/bge-small-en-v1.5      # used for canonicalization; "tfidf" = no model at all
# STUDIO_PORT=8000                        # host port for docker compose
# OLLAMA_VERSION=0.12.3
